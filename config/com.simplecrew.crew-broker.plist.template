<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.simplecrew.crew-broker</string>
  <key>ProgramArguments</key>
  <array>
    <string>__PYTHON__</string>
    <string>__ENTRYPOINT__</string>
    <string>--host</string><string>127.0.0.1</string>
    <string>--port</string><string>8765</string>
    <string>--data-dir</string><string>__DATA_DIR__</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
  <key>StandardOutPath</key><string>__DATA_DIR__/crew-broker.log</string>
  <key>StandardErrorPath</key><string>__DATA_DIR__/crew-broker-error.log</string>
</dict>
</plist>
